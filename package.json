{
  "name": "jxengine",
  "version": "1.0.0",
  "description": "Universal local LLM engine for GGUF and MLX with multi-app embedding, standalone CLI, and OpenAI/Anthropic/Ollama APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "jxengine": "bin/jxengine.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./gguf": "./dist/gguf.js",
    "./mlx": "./dist/mlx.js",
    "./server": "./dist/server.js",
    "./bridge": "./dist/bridge.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.js",
    "start": "node bin/jxengine.js serve"
  },
  "keywords": [
    "llm",
    "gguf",
    "mlx",
    "kapitsa",
    "llama.cpp",
    "local-ai",
    "inference-engine"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  }
}
